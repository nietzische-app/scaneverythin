# Copy to .env and fill in the keys you have. The app boots without them:
# ingestion and the dashboard still run; classification waits until GEMINI_API_KEY is set.

# Stage-1 noise filter (Gemini free tier). GEMINI_MODEL is tried first.
# If that id is missing, the classifier continues through
# gemini-2.5-flash, gemini-2.0-flash-exp, then gemini-1.5-flash.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Stage-2 reasoning. deepseek-chat is DeepSeek-V3. Use deepseek-reasoner for R1.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Telegram alerts. Both values are required before a message is sent.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional. When set, POST /run-scan requires: Authorization: Bearer <token>
API_TOKEN=

# SQLite file, created on startup.
DATABASE_PATH=data/radar.sqlite

# Scheduler. Interval is clamped to at least 60 seconds.
SCAN_INTERVAL_SECONDS=1800
SCAN_SCHEDULER_ENABLED=true
SCAN_ON_STARTUP=false

# Stage-1 gate. Posts under this confidence never reach DeepSeek.
CONFIDENCE_THRESHOLD=70
# batched = one Flash call with 5 atomic questions (fits the free-tier daily quota).
# parallel = five separate Flash calls per post.
CLASSIFIER_MODE=batched
CLASSIFIER_CONCURRENCY=2
ANALYZER_CONCURRENCY=1
MAX_CLASSIFICATIONS_PER_SCAN=25
MAX_ANALYSES_PER_SCAN=5
NOTIFY_MIN_OPPORTUNITY_SCORE=60

REQUEST_TIMEOUT_SECONDS=20
LLM_TIMEOUT_SECONDS=45
ANALYZER_TIMEOUT_SECONDS=90

# Ingestion budgets.
HN_STORY_LIMIT=40
HN_MIN_COMMENTS=40
HN_COMMENT_SAMPLE=2
# Reddit is read from the public Atom feed. The .json listing is only a fallback.
REDDIT_SUBS=SaaS,IndieHackers,gamedev,Showerthoughts
REDDIT_LIMIT=15
PRODUCTHUNT_FEED_URL=https://www.producthunt.com/feed

# X/Twitter is read through public Nitter-compatible RSS instances. No login.
# Each scan rotates through the account list so a day of 30-minute runs covers it.
X_MAX_ACCOUNTS_PER_SCAN=8
X_POSTS_PER_ACCOUNT=2
X_HASHTAGS_PER_SCAN=2
NITTER_INSTANCES=https://nitter.poast.org,https://nitter.privacydev.net,https://nitter.space,https://xcancel.com

LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000
