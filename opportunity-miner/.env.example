# Copy to .env and fill in the keys you have. The app boots without them:
# ingestion and the dashboard still run; classification waits until GEMINI_API_KEY is set.

# Stage-1 noise filter (Gemini free tier). GEMINI_MODEL is tried first.
# If that id is missing, the classifier continues through
# gemini-2.0-flash, gemini-1.5-flash, then gemini-2.5-flash.
# If every one of those returns 404, models.list() is tried, skipping image,
# embed, audio, and video models. A model with free-tier quota 0 is skipped.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Stage-2 Turkish brief. Default is gpt-4o-mini. Set OPENAI_MODEL=gpt-4o to upgrade.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Telegram alerts. Both values are required before a message is sent.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional. When set, POST /run-scan requires: Authorization: Bearer <token>
API_TOKEN=

# SQLite file, created on startup.
DATABASE_PATH=data/radar.sqlite

# Scheduler. Interval is clamped to at least 60 seconds.
SCAN_INTERVAL_SECONDS=1800
SCAN_SCHEDULER_ENABLED=true
SCAN_ON_STARTUP=false

# Stage-1 gate. Posts under this confidence never reach OpenAI.
CONFIDENCE_THRESHOLD=70
# batched = one Flash call with 5 atomic questions (fits the free-tier daily quota).
# parallel = five separate Flash calls per post.
CLASSIFIER_MODE=batched
CLASSIFIER_CONCURRENCY=2
ANALYZER_CONCURRENCY=1
MAX_CLASSIFICATIONS_PER_SCAN=25
MAX_ANALYSES_PER_SCAN=5
NOTIFY_MIN_OPPORTUNITY_SCORE=60

REQUEST_TIMEOUT_SECONDS=20
LLM_TIMEOUT_SECONDS=45
ANALYZER_TIMEOUT_SECONDS=90

# Ingestion budgets.
HN_STORY_LIMIT=40
HN_MIN_COMMENTS=40
HN_COMMENT_SAMPLE=2
# Reddit is read from the public Atom feed. The .json listing is only a fallback.
REDDIT_SUBS=SaaS,Entrepreneur,SmallBusiness,SideProject,Ecommerce,digitalmarketing,IndieHackers,gamedev
REDDIT_LIMIT=15
PRODUCTHUNT_FEED_URL=https://www.producthunt.com/feed

# X/Twitter is read through public Nitter-compatible RSS instances. No login.
# Each scan rotates through the account list so a day of 30-minute runs covers it.
X_MAX_ACCOUNTS_PER_SCAN=8
X_POSTS_PER_ACCOUNT=2
X_HASHTAGS_PER_SCAN=2
NITTER_INSTANCES=https://nitter.poast.org,https://nitter.privacydev.net,https://nitter.space,https://xcancel.com

# GitHub Search. No token required. GITHUB_TOKEN raises the unauthenticated rate limit.
# A repo is kept only when it clears both the star floor and stars/day.
GITHUB_TOPICS=mcp-server,ai-agent,llm-infra,workflow-automation,guardrails
GITHUB_MIN_STARS=30
GITHUB_MIN_STARS_PER_DAY=3
GITHUB_CREATED_WITHIN_DAYS=180
GITHUB_TOKEN=

# Public SaaS listings. Acquire reads the newest sitemap URLs, not the whole catalog.
# Flippa is the public marketplace (flippa.com) for listed SaaS with revenue on the page.
ACQUIRE_SITEMAP_URL=https://app.acquire.com/sitemap.xml
INDIEHACKERS_FEED_URL=https://www.indiehackers.com/feed.rss
FLIPPA_URL=https://flippa.com/buy/saas
SAAS_LISTING_LIMIT=5

# Google Trends rising queries for these seeds. A query is kept at +200% or Breakout.
TRENDS_KEYWORDS=B2B software,AI tools,workflow automation
TRENDS_MIN_GROWTH=200

# Direct X search. This does not use Nitter. Recent search needs a bearer token.
X_BEARER_TOKEN=
X_DIRECT_QUERIES=#buildinpublic,#saas,mcp server,ai agent SaaS

# Recent raises. The default list is Google News (last 7 days), Webrazzi, EU-Startups,
# and TechCrunch Venture. Set FUNDING_FEEDS only to replace it (comma-separated URLs).
FUNDING_ITEM_LIMIT=8

LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000
